# Sao chép thành .env (hoặc đặt trong bảng Environment của nơi hosting). KHÔNG commit key thật.
ANTHROPIC_API_KEY=sk-ant-...-PLACEHOLDER
APP_SECRET=chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
NODE_ENV=production
# Thư mục lưu cơ sở dữ liệu (gắn ổ đĩa bền vững vào đây khi deploy)
DATA_DIR=./data
# Tuỳ chọn: bắt buộc mã mời khi tạo văn phòng mới, hoặc tắt hẳn đăng ký
# REGISTRATION_CODE=ma-moi-cua-ban
# ALLOW_REGISTRATION=false
# Tuỳ chọn: đổi model Claude mặc định
# CLAUDE_DEFAULT_MODEL=claude-opus-5-5
