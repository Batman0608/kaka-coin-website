rules_version = '2';
// Quy tắc bảo mật cho tài khoản người chơi & cửa hàng hoa sen (dán vào Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    // danh sách admin: tạo tay trong console, tài liệu admins/<UID của tài khoản admin>
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // tài khoản người chơi: mỗi người chỉ đọc/ghi tiến trình của chính mình (không cho tài khoản ẩn danh)
    match /players/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow delete: if false;
    }

    // yêu cầu nạp
    match /topups/{id} {
      // người chơi tạo yêu cầu "chờ duyệt" cho chính mình, đúng gói và đúng tỉ lệ 1 hoa sen = 50đ
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.claimed == false
        && request.resource.data.amount in [10000, 20000, 50000, 100000, 200000, 500000]
        && request.resource.data.lotus * 50 == request.resource.data.amount
        && request.resource.data.keys().hasOnly(['uid', 'pid', 'name', 'amount', 'lotus', 'content', 'status', 'claimed', 'createdAt']);
      // người chơi chỉ đọc yêu cầu của mình; admin đọc tất cả
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // admin chấp nhận / từ chối; người chơi chỉ được đánh dấu "đã nhận" một lần sau khi được duyệt
      allow update: if (isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']))
        || (signedIn() && resource.data.uid == request.auth.uid
          && resource.data.status == 'approved' && resource.data.claimed == false
          && request.resource.data.claimed == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']));
      allow delete: if false;
    }
  }
}
